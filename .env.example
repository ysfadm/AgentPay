# ---------- Stellar / Soroban ----------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contract IDs (fill after `npm run deploy:contracts`).
# Defaults below are the live AgentPay Testnet deployment (see README).
NEXT_PUBLIC_AGENT_REGISTRY_ID=CBNPT7XGHQD75U7B2O6OSVYS4DNTUR3NJSWCEKPNOH5HDMER3DW4KBYI
NEXT_PUBLIC_MARKETPLACE_ID=CBKJXR23EMLGCONODKG4W3GHVLMZ2UN3V5WTJ2SHA6LYY5F7T2LQTJEF
NEXT_PUBLIC_DELEGATION_MANAGER_ID=CDFYTLZQ54OWK3CZT4SWCRCZXPZ7VHUY5V2DISRCQYZBXV5MZQCU2WST

# USDC (Testnet Stellar Asset Contract id). Use a SAC you control for the demo.
NEXT_PUBLIC_USDC_CONTRACT_ID=CALFVMEZVOTFQEVDMHI23ZHT5JNR3SF4BR5RMRBN6M4JT2SXEVIBMMKL

# Server-side funded account (the contract deployer / USDC issuer). Used to mint
# demo USDC and to register agents. Keep this secret — it is git-ignored in .env.local.
STELLAR_RELAYER_SECRET=

# ---------- Admin ----------
# If set, /api/admin/provision requires an `x-admin-token` header matching this.
# Leave empty for local dev.
ADMIN_TOKEN=

# Key used to encrypt agent secret keys at rest in .data/store.json.
# Falls back to STELLAR_RELAYER_SECRET if unset. Set a strong value in production.
STORE_ENC_KEY=

# ---------- AI Layer (OpenAI-compatible, optional) ----------
# If unset, the agent uses a deterministic service picker (still fully functional).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- Demo ----------
# false = live Stellar Testnet txs (use for hackathon pitch). true = instant simulated demo.
# Recommended `true` for public deployments (e.g. Vercel) so the demo always works
# without a funded relayer account.
NEXT_PUBLIC_DEMO_MODE=true
